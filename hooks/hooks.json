{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Artifact|mcp__claude_ai_Claude_Docs__batch",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/on-artifact.js"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/on-stop.js"] }
        ]
      }
    ]
  }
}
